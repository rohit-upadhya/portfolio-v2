---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Rohit Upadhya — AI/ML engineer, ex-TUM. Notes on LLMs, NLP, and legal tech." } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Rohit Upadhya</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="mx-auto w-full max-w-4xl flex-grow px-4 py-10 sm:px-6">
      {!isHome && (
        <a href="/" class="nav-link no-print mb-6 inline-block sm:hidden">
          &lt;- home
        </a>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
