/>

<style>
  /* Two pre-rendered versions: the positive (dark strokes) for light mode and
     a photographic negative (light strokes) for dark mode — swapped by theme,
     no filters, no backdrop. */
  .ascii-portrait {
    display: block;
    width: 100%;
    height: auto;
  }
  .ap-dark {
    display: none;
  }
  :root[data-theme='dark'] .ap-light {
    display: none;
  }
  :root[data-theme='dark'] .ap-dark {
    display: block;
  }
</style>
