---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiPortrait from '../components/AsciiPortrait.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

const featured = [
  { kind: 'research' as const, item: research[0] },
  { kind: 'project' as const, item: projects[0] },
  { kind: 'project' as const, item: projects[1] },
].filter((f) => f.item);
---

<BaseLayout title="Home">
  <section class="flex flex-col items-center gap-6 py-8 sm:flex-row sm:items-center sm:gap-10">
    <div class="hidden w-64 shrink-0 sm:block">
      <AsciiPortrait />
    </div>
    <div class="flex flex-1 flex-col items-center gap-6 text-center sm:items-start sm:text-left">
      <div class="flex items-center gap-4">
        <div class="w-16 shrink-0 sm:hidden">
          <AsciiPortrait />
        </div>
        <h1 class="cursor text-2xl font-bold sm:text-3xl">ROHIT UPADHYA</h1>
      </div>
      <p class="max-w-xl muted">
        Hi, I'm Rohit &mdash; a computer science graduate passionate about AI, machine learning, NLP,
        and open-source. I enjoy solving real-world problems with code and sharing what I learn.
      </p>
      <div class="flex flex-wrap justify-center gap-4 sm:hidden">
        <a href="/about" class="btn">about me</a>
        <a href="/blog" class="btn">view blog</a>
        <a href="/research" class="btn">see research</a>
      </div>
    </div>
  </section>

  <hr />

  <section class="flex flex-col gap-6">
    <div class="flex items-baseline justify-between">
      <h2 class="text-2xl font-bold">featured</h2>
      <div class="flex gap-4">
        <a href="/projects" class="nav-link text-sm">projects</a>
        <a href="/research" class="nav-link text-sm">research</a>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {featured.map(({ kind, item }) => (
        <div class="card flex flex-col gap-2">
          {kind === 'research' && item.data.kind && (
            <p class="muted text-xs uppercase tracking-wide">{item.data.kind}</p>
          )}
          <h3 class="font-bold">{item.data.title}</h3>
          <p class="muted text-sm">{item.data.description}</p>
          <a href={`/${kind === 'research' ? 'research' : 'projects'}/${item.id}`} class="nav-link text-sm">
            read more
          </a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
