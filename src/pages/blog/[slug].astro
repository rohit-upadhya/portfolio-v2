---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <a href="/blog" class="nav-link">back to blog</a>

  <article class="prose-invert mt-6 flex flex-col gap-4">
    <header>
      <h1 class="text-3xl font-bold">{post.data.title}</h1>
      <p class="muted text-sm">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      {post.data.links && post.data.links.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {post.data.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="nav-link">
              {link.label}
            </a>
          ))}
        </div>
      )}
    </header>
    <div class="prose-content">
      <Content />
    </div>
  </article>

  <a href="/blog" class="nav-link mt-8 inline-block">back to blog</a>
</BaseLayout>
