---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog" description="Weekly notes on AI, NLP, and whatever else I'm building.">
  <h1 class="mb-6 text-2xl font-bold">blog</h1>

  <div class="flex flex-col gap-4">
    {posts.map((post) => (
      <a href={`/blog/${post.id}`} class="card flex flex-col gap-2">
        <h2 class="text-xl font-bold">{post.data.title}</h2>
        <p class="muted text-sm">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
        {post.data.description && <p class="text-sm">{post.data.description}</p>}
      </a>
    ))}
    {posts.length === 0 && <p class="muted">Nothing here yet — first post is coming soon.</p>}
  </div>
</BaseLayout>
