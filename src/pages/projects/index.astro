---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Things I've built.">
  <h1 class="mb-6 text-2xl font-bold">projects</h1>

  <div class="flex flex-col gap-4">
    {items.map((item) => (
      <div class="card flex flex-col gap-3">
        <h2 class="text-xl font-bold">{item.data.title}</h2>
        <p class="text-sm">{item.data.description}</p>
        {item.data.tags && item.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {item.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
        <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 border-t border-[color:var(--border-dim)] pt-3 text-sm font-semibold">
          <a href={`/projects/${item.id}`} class="nav-link">read more</a>
          {item.data.links?.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="nav-link">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
