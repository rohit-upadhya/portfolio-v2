---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Research" description="Research, reports, and publications.">
  <h1 class="prompt mb-6 text-2xl font-bold">research, reports &amp; publications</h1>

  <div class="flex flex-col gap-4">
    {items.map((item) => (
      <div class="card flex flex-col gap-2">
        <h2 class="text-xl font-bold">{item.data.title}</h2>
        {item.data.kind && <p class="muted text-sm italic">{item.data.kind}</p>}
        <p class="text-sm">{item.data.description}</p>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          <a href={`/research/${item.id}`} class="bracket-link">read more</a>
          {item.data.links?.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="bracket-link">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <hr />

  <h2 class="prompt mb-2 text-2xl font-bold">paper reviews</h2>
  <p class="muted">coming soon</p>
</BaseLayout>
