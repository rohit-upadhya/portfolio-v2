---
import BaseLayout from '../../layouts/BaseLayout.astro';

const games = [
  { href: '/games/snake', title: 'Snake', description: 'Classic grid snake with adjustable speed. Arrow keys or WASD to move.' },
  { href: '/games/2048', title: '2048', description: 'Slide and merge tiles to reach 2048. Arrow keys, WASD, or swipe.' },
  { href: '/games/minesweeper', title: 'Minesweeper', description: 'Classic 9x9 board, 10 mines. Right-click or flag mode to flag.' },
  { href: '/games/connect-four', title: 'Connect Four', description: 'Against a minimax computer with alpha-beta pruning, 5 moves deep.' },
  { href: '/games/wordle', title: 'Wordle', description: 'Guess the 5-letter word in 6 tries.' },
];
---

<BaseLayout title="Games" description="A few small games, because why not.">
  <h1 class="mb-6 text-2xl font-bold">games</h1>

  <div class="flex flex-col gap-4">
    {games.map((game) => (
      <a href={game.href} class="card flex flex-col gap-2">
        <h2 class="text-xl font-bold">{game.title}</h2>
        <p class="text-sm muted">{game.description}</p>
      </a>
    ))}
  </div>
</BaseLayout>
