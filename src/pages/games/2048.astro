---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="2048" description="The 2048 sliding tile puzzle.">
  <a href="/games" class="nav-link">back to games</a>

  <div class="mt-6 flex flex-col items-center gap-4">
    <div class="flex w-full max-w-[360px] justify-between text-sm">
      <span>score: <span id="score">0</span></span>
      <span class="muted">best: <span id="best">0</span></span>
    </div>

    <div id="board" class="relative grid grid-cols-4 gap-2 border border-[color:var(--border)] p-2"></div>

    <p id="status" class="muted text-sm"></p>

    <p class="muted text-center text-sm">arrow keys / wasd to move &middot; swipe on mobile</p>

    <button type="button" id="restart" class="btn">restart</button>
  </div>
</BaseLayout>

<script>
  const SIZE = 4;
  const WIN_VALUE = 2048;

  const boardEl = document.getElementById('board')!;
  const scoreEl = document.getElementById('score')!;
  const bestEl = document.getElementById('best')!;
  const statusEl = document.getElementById('status')!;
  const restartBtn = document.getElementById('restart')!;

  let grid: number[][];
  let score: number;
  let won: boolean;
  let over: boolean;

  const best = { value: Number(localStorage.getItem('2048-best') || 0) };
  bestEl.textContent = String(best.value);

  function emptyGrid(): number[][] {
    return Array.from({ length: SIZE }, () => Array(SIZE).fill(0));
  }

  function emptyCells(g: number[][]): [number, number][] {
    const cells: [number, number][] = [];
    for (let r = 0; r < SIZE; r++) for (let c = 0; c < SIZE; c++) if (g[r][c] === 0) cells.push([r, c]);
    return cells;
  }

  function addRandomTile(g: number[][]) {
    const cells = emptyCells(g);
    if (cells.length === 0) return;
    const [r, c] = cells[Math.floor(Math.random() * cells.length)];
    g[r][c] = Math.random() < 0.9 ? 2 : 4;
  }

  function slideLine(line: number[]): { line: number[]; gained: number } {
    const filtered = line.filter((v) => v !== 0);
    let gained = 0;
    for (let i = 0; i < filtered.length - 1; i++) {
      if (filtered[i] !== 0 && filtered[i] === filtered[i + 1]) {
        filtered[i] *= 2;
        gained += filtered[i];
        filtered[i + 1] = 0;
      }
    }
    const merged = filtered.filter((v) => v !== 0);
    while (merged.length < SIZE) merged.push(0);
    return { line: merged, gained };
  }

  function transpose(g: number[][]): number[][] {
    return g[0].map((_, c) => g.map((row) => row[c]));
  }

  function move(direction: 'left' | 'right' | 'up' | 'down'): boolean {
    let working = grid.map((row) => [...row]);
    let gainedTotal = 0;

    if (direction === 'up' || direction === 'down') working = transpose(working);

    working = working.map((line) => {
      const oriented = direction === 'right' || direction === 'down' ? [...line].reverse() : line;
      const { line: result, gained } = slideLine(oriented);
      gainedTotal += gained;
      return direction === 'right' || direction === 'down' ? result.reverse() : result;
    });

    if (direction === 'up' || direction === 'down') working = transpose(working);

    const moved = JSON.stringify(working) !== JSON.stringify(grid);
    if (moved) {
      grid = working;
      score += gainedTotal;
      scoreEl.textContent = String(score);
      if (score > best.value) {
        best.value = score;
        localStorage.setItem('2048-best', String(best.value));
        bestEl.textContent = String(best.value);
      }
      addRandomTile(grid);
      if (!won && grid.some((row) => row.some((v) => v >= WIN_VALUE))) {
        won = true;
        statusEl.textContent = 'you made 2048! keep going or restart';
      }
      if (isGameOver(grid)) {
        over = true;
        statusEl.textContent = 'game over';
      }
    }
    return moved;
  }

  function isGameOver(g: number[][]): boolean {
    if (emptyCells(g).length > 0) return false;
    for (let r = 0; r < SIZE; r++) {
      for (let c = 0; c < SIZE; c++) {
        const v = g[r][c];
        if (c < SIZE - 1 && g[r][c + 1] === v) return false;
        if (r < SIZE - 1 && g[r + 1][c] === v) return false;
      }
    }
    return true;
  }

  function tileBg(value: number): string {
    if (!value) return 'transparent';
    const t = Math.min(Math.log2(value) / 11, 1);
    return `color-mix(in srgb, var(--accent) ${Math.round(15 + t * 55)}%, var(--bg-raised))`;
  }

  function render() {
    boardEl.innerHTML = '';
    grid.forEach((row) => {
      row.forEach((value) => {
        const div = document.createElement('div');
        div.className =
          'flex h-[70px] w-[70px] items-center justify-center border text-xl font-bold border-[color:var(--border-dim)] text-[color:var(--fg)]';
        div.style.background = tileBg(value);
        div.textContent = value ? String(value) : '';
        boardEl.appendChild(div);
      });
    });
  }

  function handleMove(direction: 'left' | 'right' | 'up' | 'down') {
    if (over) return;
    if (move(direction)) render();
  }

  function reset() {
    grid = emptyGrid();
    score = 0;
    won = false;
    over = false;
    scoreEl.textContent = '0';
    statusEl.textContent = '';
    addRandomTile(grid);
    addRandomTile(grid);
    render();
  }

  window.addEventListener('keydown', (e) => {
    switch (e.key) {
      case 'ArrowLeft':
      case 'a':
      case 'A':
        e.preventDefault();
        handleMove('left');
        break;
      case 'ArrowRight':
      case 'd':
      case 'D':
        e.preventDefault();
        handleMove('right');
        break;
      case 'ArrowUp':
      case 'w':
      case 'W':
        e.preventDefault();
        handleMove('up');
        break;
      case 'ArrowDown':
      case 's':
      case 'S':
        e.preventDefault();
        handleMove('down');
        break;
    }
  });

  restartBtn.addEventListener('click', reset);

  let touchStart: { x: number; y: number } | null = null;
  boardEl.addEventListener('touchstart', (e) => {
    const t = e.touches[0];
    touchStart = { x: t.clientX, y: t.clientY };
  });
  boardEl.addEventListener('touchend', (e) => {
    if (!touchStart) return;
    const t = e.changedTouches[0];
    const dx = t.clientX - touchStart.x;
    const dy = t.clientY - touchStart.y;
    if (Math.max(Math.abs(dx), Math.abs(dy)) > 20) {
      if (Math.abs(dx) > Math.abs(dy)) {
        handleMove(dx > 0 ? 'right' : 'left');
      } else {
        handleMove(dy > 0 ? 'down' : 'up');
      }
    }
    touchStart = null;
  });

  reset();
</script>
